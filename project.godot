; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Slacker Survivors"
run/main_scene="res://src/game/bootstrap/bootstrap_scene.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Bus="*res://src/framework/core/autoload/event_bus.gd"
App="*res://src/framework/core/autoload/app.gd"
EventBus="*res://src/framework/core/autoload/event_bus.gd"

[debug]

gdscript/warnings/redundant_await=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/build_isolation/plugin.cfg", "res://addons/ffmpeg/plugin.cfg", "res://addons/flow_graph/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/godotsteam/plugin.cfg", "res://addons/locate_in_filesystem/plugin.cfg", "res://addons/scene_define_generator/plugin.cfg", "res://addons/video_player_android/plugin.cfg", "res://addons/video_player_ios/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://docs/": "blue",
"res://docs/architecture/": "purple",
"res://docs/deployment/": "teal",
"res://docs/design/": "orange",
"res://src/": "green",
"res://src/assets/": "yellow",
"res://src/framework/": "red",
"res://src/game/": "purple",
"res://src/resources/": "teal",
"res://src/test/": "pink"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
