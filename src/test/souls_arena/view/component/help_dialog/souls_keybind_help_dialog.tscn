[node name="KeybindRichText" type="RichTextLabel" parent="ModalCard/RootVBox/Columns/LeftSubPanel/LeftVBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 12
theme_override_font_sizes/bold_font_size = 12
bbcode_enabled = true
text = "[b][color=#ffd875][WASD][/color][/b]   3D 走位 / 锁定环绕

[b][color=#7ce8ff][Space][/color][/b]   8 向翻滚（0.30s 无敌帧，可取消后摇）

[b][color=#ff9e7c][左键 / J][/color][/b]   三段连击 / 破防处决

[b][color=#9df08e][右键 / K][/color][/b]   点按 0.18s 弹反 / 按住举盾格挡

[b][color=#ffd875][Q / 中键][/color][/b]   切换目标锁定

[b][color=#c5d4eb][鼠标滚轮][/color][/b]   缩放相机视距

[b][color=#c5d4eb][B / Tab][/color][/b]   行为树蓝图     [b][color=#c5d4eb][R][/color][/b]   重置对局"

