@tool
extends RefCounted

## 场景契约代码生成与幂等写盘服务（Define Service）。[br]
##
## [b]核心职责：[/b][br]
## 1. 调用 `SceneScanner` 获取路由场景快照并按 ASCII 字典序组装确定性 GDScript 代码；[br]
## 2. 比对内存生成代码与磁盘现有文件（`is_in_sync`），支持编辑器底部栏只读预览；[br]
## 3. 执行幂等 Diff 写盘（内容未变时零磁盘 I/O，防止触发编辑器无限重扫）。

const SceneScanner = preload("scene_scanner.gd")

const SCAN_ROOT: String = "res://src/game"
const OUTPUT_PATH: String = "res://src/game/shared/define/generated/game_scenes.gd"

## 尚未创建物理 .tscn 文件时的预留路由占位项（一旦物理文件创建于任意子目录，自动被真实扫描路径覆盖）
const PLANNED_SCENES: Dictionary = {
	"LOBBY": "res://src/game/features/lobby/view/lobby_scene.tscn",
	"BATTLE": "res://src/game/features/battle/view/battle_scene.tscn",
}


#region Public API
## 生成只读预览快照（不执行写盘）。[br]
## @return 返回字典：{"scenes": Dictionary, "dialogs": Dictionary, "components": Dictionary, "preview_code": String, "is_in_sync": bool, "output_path": String}
func preview() -> Dictionary:
	return preview_static()


## 执行一键注入写盘。[br]
## @return 返回字典：{"changed": bool, "scene_count": int, "dialog_count": int, "component_count": int, "output_path": String, "preview_code": String}
func inject() -> Dictionary:
	return generate_headless()


## 静态预览入口（供无实例上下文或 CLI 直接调用）
static func preview_static() -> Dictionary:
	var scanned := SceneScanner.scan(SCAN_ROOT, PLANNED_SCENES)
	var scenes: Dictionary = scanned["scenes"]
	var dialogs: Dictionary = scanned["dialogs"]
	var components: Dictionary = scanned["components"]

	var preview_code := _build_source_code(scenes, dialogs, components)
	var is_in_sync := false
	if FileAccess.file_exists(OUTPUT_PATH):
		is_in_sync = (FileAccess.get_file_as_string(OUTPUT_PATH) == preview_code)

	return {
		"scenes": scenes,
		"dialogs": dialogs,
		"components": components,
		"preview_code": preview_code,
		"is_in_sync": is_in_sync,
		"output_path": OUTPUT_PATH,
	}


## 静态无头生成入口（供 check_syntax.gd 或 CI 脚本一键同步调用）
static func generate_headless() -> Dictionary:
	var snap := preview_static()
	var scenes: Dictionary = snap["scenes"]
	var dialogs: Dictionary = snap["dialogs"]
	var components: Dictionary = snap["components"]
	var content: String = snap["preview_code"]

	var changed := _write_if_changed(OUTPUT_PATH, content)

	return {
		"changed": changed,
		"scene_count": scenes.size(),
		"dialog_count": dialogs.size(),
		"component_count": components.size(),
		"output_path": OUTPUT_PATH,
		"preview_code": content,
	}
#endregion


#region Internal Code Formatting & Disk I/O
static func _build_source_code(
	scenes: Dictionary,
	dialogs: Dictionary,
	components: Dictionary
) -> String:
	var lines := PackedStringArray()
	lines.append("# ==============================================================================")
	lines.append("# AUTO-GENERATED BY SceneDefineGenerator - DO NOT EDIT MANUALLY")
	lines.append("# Target: res://src/game/shared/define/generated/game_scenes.gd")
	lines.append("# ==============================================================================")
	lines.append("class_name GameScenes")
	lines.append("extends RefCounted")
	lines.append("")
	lines.append("## 跨模块路由级场景路径自动注入契约表（位于 src/game/shared/define/generated/）。[br]")
	lines.append("## 由 `addons/scene_define_generator` 插件扫描 [code]res://src/game/[/code] 注入，严禁人工手改。")
	lines.append("")

	_append_group_class(lines, "Scene", "顶层主场景路由契约 (继承自 BaseScene)", scenes)
	lines.append("")
	_append_group_class(lines, "Dialog", "模态弹窗路由契约 (继承自 BaseDialog)", dialogs)
	lines.append("")
	_append_group_class(lines, "Component", "跨模块通用 UI 组件预制件契约 (位于 src/game/shared/component/)", components)
	lines.append("")

	return "\n".join(lines)


static func _append_group_class(
	lines: PackedStringArray,
	class_title: String,
	doc_comment: String,
	entries: Dictionary
) -> void:
	lines.append("## %s" % doc_comment)
	lines.append("class %s:" % class_title)
	if entries.is_empty():
		lines.append("\tpass")
		return

	var keys: Array = entries.keys()
	keys.sort()
	for k in keys:
		var const_name := String(k)
		var path_val := String(entries[k])
		lines.append("\tconst %s: String = \"%s\"" % [const_name, path_val])


static func _write_if_changed(res_path: String, new_content: String) -> bool:
	var abs_dir := ProjectSettings.globalize_path(res_path.get_base_dir())
	if not DirAccess.dir_exists_absolute(abs_dir):
		DirAccess.make_dir_recursive_absolute(abs_dir)

	if FileAccess.file_exists(res_path):
		var existing := FileAccess.get_file_as_string(res_path)
		if existing == new_content:
			return false

	var file := FileAccess.open(res_path, FileAccess.WRITE)
	if file == null:
		push_error("[SceneDefineGenerator] Failed to write generated file: %s" % res_path)
		return false
	file.store_string(new_content)
	file.close()
	return true
#endregion
